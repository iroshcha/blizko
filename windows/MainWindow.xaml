<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Близко" Width="1080" Height="760" MinWidth="860" MinHeight="600"
        WindowStartupLocation="CenterScreen" Background="#F5F6F2" FontFamily="Segoe UI"
        Foreground="#1C302B" FontSize="14">
  <Window.Resources>
    <SolidColorBrush x:Key="Green" Color="#236C58"/>
    <Style TargetType="Button">
      <Setter Property="Padding" Value="16,11"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Foreground" Value="#236C58"/><Setter Property="Background" Value="White"/>
      <Setter Property="BorderThickness" Value="0"/><Setter Property="FontSize" Value="14"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="ButtonBorder" CornerRadius="10" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.8"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.4"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Padding" Value="12,10"/><Setter Property="Background" Value="White"/>
      <Setter Property="BorderBrush" Value="#DEE5DE"/><Setter Property="BorderThickness" Value="1"/>
      <Setter Property="FontSize" Value="15"/><Setter Property="Foreground" Value="#1C302B"/>
    </Style>
    <Style TargetType="ListBoxItem">
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="12"/>
      <Setter Property="Margin" Value="0,0,0,8"/><Setter Property="Background" Value="White"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
        <Border x:Name="Row" Background="{TemplateBinding Background}" CornerRadius="12" Padding="{TemplateBinding Padding}">
          <ContentPresenter/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="#DCEEE4"/></Trigger>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="BorderBrush" Value="#94B8A6"/><Setter TargetName="Row" Property="BorderThickness" Value="1"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
  </Window.Resources>
  <Grid x:Name="Shell" Background="#F5F6F2">
    <Grid.ColumnDefinitions><ColumnDefinition Width="310"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border BorderBrush="#E2E7E0" BorderThickness="0,0,1,0" Padding="22,28,22,20">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel>
          <StackPanel Orientation="Horizontal">
            <Border Background="#236C58" CornerRadius="13" Width="44" Height="44" Margin="0,0,12,0">
              <TextBlock Text="б" Foreground="White" FontWeight="SemiBold" FontSize="29" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-4,0,0"/>
            </Border>
            <TextBlock Text="Близко" FontSize="30" FontWeight="SemiBold" VerticalAlignment="Center"/>
          </StackPanel>
          <TextBlock Text="Личное остаётся у вас" Foreground="#65766F" Margin="0,12,0,24"/>
        </StackPanel>
        <Border Grid.Row="1" Background="White" CornerRadius="12" Padding="14" Margin="0,0,0,14">
          <StackPanel>
            <TextBlock x:Name="Status" Text="Открываем хранилище…" TextWrapping="Wrap" Foreground="#236C58" Margin="0,0,0,10"/>
            <Button x:Name="Receive" Content="Включить приём" Background="#236C58" Foreground="White" IsEnabled="False"/>
          </StackPanel>
        </Border>
        <Grid Grid.Row="2" Margin="0,0,0,24">
          <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
          <Button x:Name="MyQR" Content="Мой QR" Margin="0,0,5,0" IsEnabled="False"/>
          <Button x:Name="AddContact" Content="+ Контакт" Grid.Column="1" Margin="5,0,0,0" IsEnabled="False"/>
        </Grid>
        <StackPanel Grid.Row="3" Margin="0,0,0,12">
          <TextBlock Text="ПЕРЕПИСКИ" Foreground="#65766F" FontSize="11" Margin="0,0,0,12"/>
          <Grid>
            <TextBox x:Name="Search" ToolTip="Поиск по имени контакта" AutomationProperties.Name="Поиск контакта"/>
            <TextBlock Text="Поиск контакта" Foreground="#829087" Margin="12,10" IsHitTestVisible="False">
              <TextBlock.Style><Style TargetType="TextBlock">
                <Setter Property="Visibility" Value="Collapsed"/>
                <Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=Search}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
              </Style></TextBlock.Style>
            </TextBlock>
          </Grid>
        </StackPanel>
        <Grid Grid.Row="4">
          <ListBox x:Name="Contacts" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate><DataTemplate>
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Background="#E8F1EB" CornerRadius="18" Width="36" Height="36" VerticalAlignment="Center">
                  <TextBlock Text="{Binding Initial}" FontSize="18" Foreground="#236C58" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" Margin="6,0,0,0">
                  <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="15" TextTrimming="CharacterEllipsis"/>
                  <TextBlock Text="{Binding Preview}" FontSize="12" Foreground="#65766F" Margin="0,5,0,0" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
              </Grid>
            </DataTemplate></ListBox.ItemTemplate>
          </ListBox>
          <TextBlock x:Name="NoContacts" Text="Здесь появятся ваши разговоры." Foreground="#65766F" TextWrapping="Wrap" Margin="4,22,4,0"/>
        </Grid>
        <DockPanel Grid.Row="5" Margin="0,18,0,0">
          <Button x:Name="Settings" Content="Настройки" Padding="10,8" Background="Transparent"/>
          <TextBlock Text="Windows · 0.2.4" Foreground="#829087" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center"/>
        </DockPanel>
      </Grid>
    </Border>
    <Grid Grid.Column="1">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Border Background="White" BorderBrush="#E2E7E0" BorderThickness="0,0,0,1" Padding="28,24">
        <DockPanel>
          <Button x:Name="CheckContact" Content="Проверить связь" DockPanel.Dock="Right" Background="#F0F4EE" IsEnabled="False" VerticalAlignment="Center" Margin="12,0,0,0"/>
          <StackPanel><TextBlock x:Name="ChatTitle" Text="Ваш первый разговор" FontSize="23" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
            <TextBlock x:Name="ChatSubtitle" Text="Без регистрации. По вашему QR." Foreground="#65766F" Margin="0,5,0,0"/></StackPanel>
        </DockPanel>
      </Border>
      <Border x:Name="IssueBox" Grid.Row="1" Visibility="Collapsed" Background="#FFF0D9" CornerRadius="8" Margin="24,16,24,0" Padding="12">
        <TextBlock x:Name="Issue" Foreground="#765A26" TextWrapping="Wrap"/>
      </Border>
      <Grid Grid.Row="2">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <WrapPanel x:Name="HistoryControls" Orientation="Horizontal" Margin="28,10,28,0" Visibility="Collapsed">
          <Button x:Name="Older" Content="Раньше" Margin="0,0,8,0"/>
          <Button x:Name="Recent" Content="Последние" Margin="0,0,8,0"/>
          <Button x:Name="FindMessages" Content="Найти" Margin="0,0,8,0"/>
          <Button x:Name="ClearHistory" Content="Очистить историю"/>
        </WrapPanel>
        <ScrollViewer Grid.Row="1" x:Name="MessageScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed">
          <StackPanel x:Name="Messages" Margin="28,18,28,18"/>
        </ScrollViewer>
        <StackPanel Grid.Row="1" x:Name="Welcome" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="380" Margin="28">
          <Grid Width="132" Height="98" Margin="0,0,0,24">
            <Border Width="86" Height="60" Background="#E0EAE0" CornerRadius="22" HorizontalAlignment="Left" VerticalAlignment="Top"/>
            <Border Width="90" Height="60" Background="#236C58" CornerRadius="22" HorizontalAlignment="Right" VerticalAlignment="Bottom">
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Ellipse Width="7" Height="7" Fill="White" Margin="4"/><Ellipse Width="7" Height="7" Fill="White" Margin="4"/><Ellipse Width="7" Height="7" Fill="White" Margin="4"/>
              </StackPanel>
            </Border>
          </Grid>
          <TextBlock Text="Рядом, даже на расстоянии" FontSize="24" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap"/>
          <TextBlock Text="Добавьте QR друга и отправьте ему свой. Можно общаться с Android и другим компьютером." Foreground="#65766F" FontSize="15" TextAlignment="Center" TextWrapping="Wrap" Margin="0,14,0,0" LineHeight="24"/>
          <TextBlock Text="История и недоставленные сообщения&#10;сохраняются на этом компьютере." Foreground="#829087" FontSize="12" TextAlignment="Center" Margin="0,24,0,0" LineHeight="20"/>
        </StackPanel>
      </Grid>
      <Border Grid.Row="3" BorderBrush="#E2E7E0" BorderThickness="0,1,0,0" Padding="24,16,24,18" Background="#F5F6F2">
        <StackPanel>
          <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBox x:Name="Compose" AcceptsReturn="True" MaxLength="4000" MinHeight="46" MaxHeight="120" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" IsEnabled="False" AutomationProperties.Name="Сообщение"/>
            <Button x:Name="Send" Content="Отправить" Grid.Column="1" Background="#236C58" Foreground="White" Margin="12,0,0,0" VerticalAlignment="Bottom" IsEnabled="False"/>
          </Grid>
          <TextBlock Text="Enter — отправить · Shift+Enter — новая строка" Foreground="#829087" FontSize="11" Margin="0,8,0,0"/>
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</Window>
